<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Copia interna de factura. No define 'attachment' a propósito: el PDF
         no debe quedar adjunto al comprobante para no confundirse con el CFE. -->
    <record id="action_report_invoice_internal_copy" model="ir.actions.report">
        <field name="name">Factura - copia interna (sin valor fiscal)</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_uy_invoice_internal_copy.report_invoice_internal_copy</field>
        <field name="report_file">l10n_uy_invoice_internal_copy.report_invoice_internal_copy</field>
        <field name="print_report_name">'Copia interna - %s' % (object.name or '').replace('/', '_')</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_type">report</field>
        <field name="groups_id" eval="[(4, ref('l10n_uy_invoice_internal_copy.group_print_internal_copy'))]"/>
    </record>

    <!-- Copia interna de recibo de pago. -->
    <record id="action_report_payment_receipt_internal_copy" model="ir.actions.report">
        <field name="name">Recibo - copia interna (sin valor fiscal)</field>
        <field name="model">account.payment</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_uy_invoice_internal_copy.report_payment_receipt_internal_copy</field>
        <field name="report_file">l10n_uy_invoice_internal_copy.report_payment_receipt_internal_copy</field>
        <field name="print_report_name">'Copia interna - %s' % (object.name or '').replace('/', '_')</field>
        <field name="binding_model_id" ref="account.model_account_payment"/>
        <field name="binding_type">report</field>
        <field name="groups_id" eval="[(4, ref('l10n_uy_invoice_internal_copy.group_print_internal_copy'))]"/>
    </record>

</odoo>
